APP_NAME=backend-petunjukku
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./backend_petunjukku.db
SQL_ECHO=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BACKEND=auto
LOCAL_LLM_PROVIDER=auto
LOCAL_LLM_MODEL_PATH=
LOCAL_LLM_DEVICE=auto
LOCAL_LLM_MAX_NEW_TOKENS=256
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_TOP_P=0.9
