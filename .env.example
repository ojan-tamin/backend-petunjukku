APP_NAME=backend-petunjukku
APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite:///./backend_petunjukku.db
SQL_ECHO=false
SECRET_KEY=change-this-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# LLM Flow Intra - mengikuti Project A via OpenRouter
LLM_PROVIDER=openrouter
LLM_MODEL=moonshotai/kimi-k2.5:nitro
LLM_API_KEY=your-openrouter-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_HTTP_REFERER=https://petunjukku.id
